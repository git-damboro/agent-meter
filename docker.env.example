# Host port and optional browser origin allowed to read the public snapshot API.
AGENT_METER_PORT=3000
AGENT_METER_PUBLIC_ORIGIN=http://localhost:4321
AGENT_METER_COLLECT_INTERVAL_SECONDS=3600

# Preferred when your Codex account can issue an at- personal access token.
CODEX_PERSONAL_ACCESS_TOKEN=

# OAuth fallback. Leave these empty when using a personal access token.
CODEX_ACCOUNT_ID=
CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=

# Change this value when intentionally replacing the OAuth credential bundle.
CODEX_CREDENTIAL_VERSION=v1

# Optional display metadata. Email is never written to the public snapshot.
CODEX_ACCOUNT_EMAIL=
CODEX_PLAN_TYPE=
